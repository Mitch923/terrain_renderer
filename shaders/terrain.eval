#version 410

layout(quads, equal_spacing, ccw) in;

uniform mat4 viewMatrix;
uniform mat4 projMatrix;

// Terrain settings
uniform float terrainHeightBound; // Terrain is bound to [-terrainHeightBound, terrainHeightBound]
uniform float terrainFrequency;
uniform float terrainAmplitude;
uniform float waterLevel; // Pre-calculated
uniform float time;
uniform float transitionWidth;
uniform uint terrainSeed;

// Outputs for fragment shader
out vec3 positionEyeSpace;
out vec3 normalEyeSpace;
out vec3 diffuseColour;
out vec2 texCoord;
out float slope;
out float heightNorm;
out float waterLevelNorm;

const float PI = 3.14159265358979;

// Infinite perlin noise based on hashing
vec2 gradientHash(ivec2 pos, uint seed) {
    // Multiply inputs with big primes (https://bigprimes.org/)
    // Using primes minimizes patterns
    uint h = uint(pos.x) * 646016809u + uint(pos.y) * 869240873u + seed * 406460479u;

    // Use funky triple 32 scrambler from (https://www.shadertoy.com/view/WttXWX)
    h ^= h >> 17u;
    h *= 0xed5ad4bbu;
    h ^= h >> 11u;
    h *= 0xac4c1b51u;
    h ^= h >> 15u;
    h *= 0x31848babu;
    h ^= h >> 14u;

    // Convert back into a vec2 gradient vector
    // Divide by max 32-bit int value
    float angle = (float(h) / float(0xffffffffu)) * 2.0f * PI;
    return vec2(cos(angle), sin(angle));
}

vec2 smootherStep(vec2 f) {
    return f * f * f * (f * (f * 6.0 - 15.0) + 10.0); // Horner's method
}

float perlinNoise(vec2 coord) {
    // Integer grid coordinates
    ivec2 i = ivec2(floor(coord));

    // Local position within integer grid
    vec2 f = fract(coord);

    // Random gradients for each corner
    vec2 g00 = gradientHash(i + ivec2(0, 0), terrainSeed);
    vec2 g01 = gradientHash(i + ivec2(0, 1), terrainSeed);
    vec2 g10 = gradientHash(i + ivec2(1, 0), terrainSeed);
    vec2 g11 = gradientHash(i + ivec2(1, 1), terrainSeed);

    // Vectors from corners
    vec2 v00 = f - vec2(0.0, 0.0);
    vec2 v01 = f - vec2(0.0, 1.0);
    vec2 v10 = f - vec2(1.0, 0.0);
    vec2 v11 = f - vec2(1.0, 1.0);

    // Dot products for corners and local vectors
    float d00 = dot(g00, v00);
    float d01 = dot(g01, v01);
    float d10 = dot(g10, v10);
    float d11 = dot(g11, v11);

    vec2 u = smootherStep(f);

    // Bilinear interp
    float nx0 = mix(d00, d10, u.x);
    float nx1 = mix(d01, d11, u.x);
    float noiseVal = mix(nx0, nx1, u.y);

    // Perlin outputs values between [-sqrt(N)/2, sqrt(N)/2] so normalise to [-1, 1]
    return noiseVal * 1.41421356237; // sqrt(2)
}

float getTerrainHeight(vec2 pos) {
    float totalHeight = 0.0;
    float frequency = terrainFrequency;
    float amplitude = terrainAmplitude;
    float maxAmplitude = 0.0;

    for (int i = 0; i < 5; i++) {
        float noise = perlinNoise(pos * frequency);
        totalHeight += noise * amplitude;
        maxAmplitude += amplitude;

        amplitude *= 0.5;
        frequency *= 2.0;
    }

    return (totalHeight / maxAmplitude) * terrainHeightBound; // Bound to terrainHeightBound
}

// Returns the final world-space Y height, including wave displacement for underwater points
float getHeightWorldSpace(vec2 pos) {
    float h = getTerrainHeight(pos);
    float worldH = clamp(h, waterLevel, terrainHeightBound);

    // Smooth transition zone: waves fade in/out over this height range (world-space units)
    float shoreDepth = (waterLevel - h); // positive = underwater, negative = above water

    // Blend factor: ~1.0 when well underwater, ~0.0 when above shore line
    float waveBlend = smoothstep(-transitionWidth, transitionWidth, shoreDepth);

    // Depth for amplitude falloff -- clamp to avoid division issues near shore
    float depthForAmp = max(shoreDepth, 0.5);
    float amp = (0.05 + 0.15 / depthForAmp) * waveBlend;

    worldH += sin(pos.x * 0.8  + time * 2.0) * amp;
    worldH += sin(pos.y * 0.6  + time * 1.7) * amp * 0.4;
    worldH += sin((pos.x + pos.y) * 0.4 + time * 3.0) * amp * 0.25;

    return worldH;
}

void main() {
    vec4 posn;
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    posn = (1-u) * (1-v) * gl_in[0].gl_Position
            + u * (1-v) * gl_in[1].gl_Position
            + u * v * gl_in[2].gl_Position
            + (1-u) * v * gl_in[3].gl_Position;

    float height = getTerrainHeight(posn.xz);
    posn.y = getHeightWorldSpace(posn.xz);

    // Calculate Normal using the same helper -- normals automatically include wave curvature
    float eps = 0.5;
    float hL = getHeightWorldSpace(posn.xz - vec2(eps, 0.0));
    float hR = getHeightWorldSpace(posn.xz + vec2(eps, 0.0));
    float hD = getHeightWorldSpace(posn.xz - vec2(0.0, eps));
    float hU = getHeightWorldSpace(posn.xz + vec2(0.0, eps));

    vec3 tangentX = vec3(2.0 * eps, hR - hL, 0.0);
    vec3 tangentZ = vec3(0.0, hU - hD, 2.0 * eps);
    vec3 normalWorld = normalize(cross(tangentZ, tangentX));

    // Outputs for terrain.frag
    slope = 1.0 - normalWorld.y;
    heightNorm = clamp((height * 10) / (terrainHeightBound * 10) * 0.5 + 0.5, 0.0, 1.0);
    normalEyeSpace = normalize(mat3(viewMatrix) * normalWorld);
    gl_Position = projMatrix * viewMatrix * posn;
    positionEyeSpace = vec3(viewMatrix * posn);
    diffuseColour = vec3(1.0, 1.0, 1.0);
    texCoord = posn.xz * 0.1; // World-space UVs for infinite texture tiling
    waterLevelNorm = clamp(waterLevel / terrainHeightBound * 0.5 + 0.5, 0.0, 1.0);
}
