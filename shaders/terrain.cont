#version 410

layout(vertices = 4) out;
uniform vec3 eyePos;
uniform float levelHigh;
uniform float levelLow;
uniform float distMin;
uniform float distMax;

float getTessLevel(vec3 target) {
    float dist = clamp(distance(eyePos, target), distMin, distMax);
    float normalizedDist = (dist - distMin) / (distMax - distMin);
    float level = mix(levelHigh, levelLow, normalizedDist);
    return level;
}

void main() {

    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;

    if (gl_InvocationID == 0) {
        vec3 p0 = gl_in[0].gl_Position.xyz;
        vec3 p1 = gl_in[1].gl_Position.xyz;
        vec3 p2 = gl_in[2].gl_Position.xyz;
        vec3 p3 = gl_in[3].gl_Position.xyz;


        gl_TessLevelOuter[0] = getTessLevel(mix(p0, p3, 0.5)); // Left edge
        gl_TessLevelOuter[1] = getTessLevel(mix(p0, p1, 0.5)); // Bottom edge
        gl_TessLevelOuter[2] = getTessLevel(mix(p1, p2, 0.5)); // Right edge
        gl_TessLevelOuter[3] = getTessLevel(mix(p2, p3, 0.5)); // Top edge

        // Inner levels can be an average of outer levels
        gl_TessLevelInner[0] = mix(gl_TessLevelOuter[0], gl_TessLevelOuter[2], 0.5);
        gl_TessLevelInner[1] = mix(gl_TessLevelOuter[1], gl_TessLevelOuter[3], 0.5);
    }
}
